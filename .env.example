# ---------------------------------------------------------------------------
# The Stacks - environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Google Books API key. OPTIONAL - the volumes search endpoint works without
# one, but an unkeyed client is rate limited by IP.
#
# IMPORTANT: anything prefixed with VITE_ is inlined into the client bundle and
# is therefore PUBLIC. Only put a browser-restricted (HTTP-referrer limited)
# key here. If you ever need a secret credential, proxy the call through a
# server instead - see docs/SPEC.md section 14.
VITE_GOOGLE_BOOKS_API_KEY=

# Which provider the BookService prefers. "google" | "openlibrary"
VITE_BOOK_PROVIDER=google

# Bump to invalidate locally persisted data after a breaking schema change.
VITE_STORAGE_NAMESPACE=the-stacks

# Neon Data API base URL. Public by design: access is controlled by the GRANTs
# on the `anonymous` role and by RLS, not by keeping this secret. Leave it unset
# to keep the library in localStorage. NEVER put the Postgres connection string
# in a VITE_ variable; it would ship the whole database to the browser.
VITE_NEON_DATA_API_URL=
