# ---------------------------------------------------------------------------
# The Stacks - environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Google Books API key. OPTIONAL - the volumes endpoint works without one, but
# an unkeyed caller is rate limited by IP and searches fall through to Open
# Library.
#
# SERVER ONLY. Note the missing VITE_ prefix: anything prefixed with VITE_ is
# inlined into the client bundle and is therefore public. This one is read by
# `api/search.ts`, so the browser never sees it and the key does not need an
# HTTP referrer restriction to be safe. On Vercel add it as a Secret.
#
# `pnpm dev` reads it through `tooling/apiDevPlugin.ts`, which means a change
# here needs a dev server RESTART rather than a reload.
GOOGLE_BOOKS_API_KEY=

# Which provider the BookService prefers. "google" | "openlibrary"
VITE_BOOK_PROVIDER=google

# Bump to invalidate locally persisted data after a breaking schema change.
VITE_STORAGE_NAMESPACE=the-stacks

# Neon project base URL, e.g.
#   https://ep-xxx.c-2.eu-west-2.aws.neon.tech/neondb
# The client derives the Data API and auth hosts from it. Public by design:
# access is controlled by the GRANTs on the `anonymous` role and by RLS, not by
# keeping this secret. Leave it unset to keep the library in localStorage.
#
# NEVER put the Postgres connection string in a VITE_ variable; it would ship
# the whole database to the browser. Keep it as an unprefixed DATABASE_URL.
VITE_NEON_URL=

# The owner's auth user id: what `auth.user_id()` returns for them, and the same
# literal the RLS policy pins writes to. Read it with
#   select id, email from neon_auth.user;
# NOT a secret. It only decides which controls the interface draws; RLS decides
# what is actually permitted. Unset means nobody is treated as the owner, so the
# editing controls stay hidden.
VITE_LIBRARY_OWNER_ID=
